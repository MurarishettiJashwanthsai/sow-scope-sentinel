# Local database and authentication
SCOPE_SENTINEL_DB=scope_sentinel.db
SCOPE_SENTINEL_AUTH_REQUIRED=true
SCOPE_SENTINEL_SECURE_COOKIES=true
# Required for first-admin setup when secure cookies are enabled.
SCOPE_SENTINEL_BOOTSTRAP_TOKEN=
SCOPE_SENTINEL_ALLOWED_HOSTS=127.0.0.1,localhost
SCOPE_SENTINEL_ALLOWED_ORIGINS=https://127.0.0.1:8443,https://localhost:8443
SCOPE_SENTINEL_LOGIN_RATE_LIMIT=20
SCOPE_SENTINEL_LOCKOUT_ATTEMPTS=5
SCOPE_SENTINEL_LOCKOUT_MINUTES=15
SCOPE_SENTINEL_MAX_SESSIONS_PER_USER=5
SCOPE_SENTINEL_MAX_UPLOAD_MB=10

# Optional evidence-cited OpenAI Responses API review.
# Both variables must be present; otherwise the local rule engine is used.
OPENAI_API_KEY=
SCOPE_SENTINEL_LLM_MODEL=

# Jira admin webhook HMAC verification
JIRA_WEBHOOK_SECRET=

# Slack inbound request verification and outbound bot authentication
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# PostgreSQL/pgvector deployment target (migration assets are in migrations/postgres)
DATABASE_URL=postgresql://sentinel:sentinel_local_only@127.0.0.1:5432/scope_sentinel
